{
  "description": "Block secret writes into git repositories. Loaded automatically by Claude Code from hooks/hooks.json.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/block_secret_writes.py"
            ]
          }
        ]
      }
    ]
  }
}
